# ── Google Sheets ────────────────────────────────────────────────────
# The long id from the spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_ID=
# From the service-account JSON: "client_email".
# The OHC checklist project's service account works here — just share this
# spreadsheet with the same address as Editor. No new GCP setup needed.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# From the same JSON: "private_key". Keep it on ONE line with the \n escapes
# intact, and wrap it in double quotes.
GOOGLE_PRIVATE_KEY=

# Optional: point at the local stand-in instead of Google (see README).
# Honoured only for loopback addresses, so it cannot disable auth by accident.
# GOOGLE_SHEETS_API_BASE=http://127.0.0.1:8787/v4/spreadsheets

# ── Photo uploads (optional) ─────────────────────────────────────────
# From the Cloudinary dashboard (free, no card). Leave all three blank and the
# photo field renders disabled with a note saying how to turn it on — every
# other part of the portal still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Town office dashboard login ──────────────────────────────────────
# IMPORTANT: wrap in double quotes if the password contains "#", or
# everything after the # is treated as a comment and silently dropped.
ADMIN_PASSWORD=
# Any random string, 16+ characters. Signs the admin session cookie.
AUTH_SECRET=

# Optional: one shared code for maintenance staff, required to close a
# complaint. Blank = /resolve stays open and the token alone is the key.
STAFF_ACCESS_CODE=
